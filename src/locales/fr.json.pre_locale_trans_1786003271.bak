  "termsOfService_ip_title": "Propriété intellectuelle",
  "termsOfService_lastUpdated": "Dernière mise à jour : 4 août 2026",
  "termsOfService_limitation_p1": "Phantom Blade Zero Wiki et ses contributeurs ne sont pas responsables des dommages découlant de l'utilisation de ce site.",
  "termsOfService_limitation_title": "Limitation of Liability",
  "termsOfService_links_p1": "This site contains links to third-party websites. We are not responsible for their content or privacy practices.",
  "termsOfService_links_title": "External Links",
  "termsOfService_title": "Terms of Service",
