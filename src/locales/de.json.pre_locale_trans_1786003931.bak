  "home_feature_combat_desc": "Color-coded attacks, parry brutal moves, dodge killer moves, Ghostep repositioning counter — offense and defense blur into one flow",
  "home_feature_endings": "8 Distinct Endings",
  "home_feature_endings_desc": "Side quests change the main story — your choices and quest completion determine which of 8 endings you unlock",
  "home_feature_phantom": "20+ Phantom Edges",
  "home_feature_phantom_desc": "Secondary weapons from boss drops — bows, halberds, warhammers, lion masks — each with limited uses and unique combos",
  "home_feature_weapons": "30+ Unique Weapons",
  "home_feature_weapons_desc": "Longswords, chakrams, greatswords, whip swords — each with unique move sets, signature techniques, and power surge ultimates",
