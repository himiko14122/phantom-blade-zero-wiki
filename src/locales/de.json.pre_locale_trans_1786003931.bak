  "termsOfService_use_notAllowed_title": "Nicht erlaubt",
  "termsOfService_use_p1": "Sie dürfen diese Website für persönliche, nicht-kommerzielle Zwecke nutzen.",
  "termsOfService_use_personal": "Informationen als persönliche Spielhilfe nutzen",
