  "category_cards_lore_4_subtitle": "Kill-intent composition — 7-beat alternating rhythm",
  "category_cards_lore_4_f0": "Composer Caisheng Bo chose erhu to convey kill-intent rather than traditional sorrow",
  "category_cards_lore_4_f1": "Unique 7-beat rhythm alternating 4+3 and 3+4 — syncs with combat flow",
  "category_cards_lore_4_f2": "Traditional instrument, untraditional emotional register — core of Kungfupunk identity",
