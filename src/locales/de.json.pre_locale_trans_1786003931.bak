  "category_cards_guides_0_f0_label": "Parry",
  "category_cards_guides_0_f0_value": "Negate brutal (gold/orange) attacks without Sha-Chi cost and drain enemy resource",
  "category_cards_guides_0_f1_label": "Dodge",
  "category_cards_guides_0_f1_value": "Avoid killer (red) moves at the last moment to trigger Ghostep counter",
